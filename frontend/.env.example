# REST and media proxy target (server-side).
API_ORIGIN=http://127.0.0.1:8000
# WebSocket base URL, without /ws. Use your API hostname for remote clients.
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000
# WebRTC ICE servers. Add a TURN server for networks that block direct peer connections.
# See ../turn/README.md for setup and forced-relay verification. Rebuild after changing.
NEXT_PUBLIC_RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:stun1.l.google.com:19302"}]
