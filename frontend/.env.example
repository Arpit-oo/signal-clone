# REST and media proxy target (server-side).
API_ORIGIN=http://127.0.0.1:8000
# WebSocket base URL, without /ws. Use your API hostname for remote clients.
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000
# Optional WebRTC ICE servers. Local calling works without an external server.
# For calls across networks, supply STUN and TURN servers as a JSON array.
NEXT_PUBLIC_RTC_ICE_SERVERS=[]
