# Optional Docker Compose overrides. Copy to .env in the project root.
# These defaults work with: docker compose up --build -d --wait
FRONTEND_PORT=3000
BACKEND_PORT=8000
BIND_ADDRESS=127.0.0.1
SEED_ON_STARTUP=true

# Optional. A blank value generates a random signing secret in the data volume.
# Set a long random value here to manage the signing secret yourself.
JWT_SECRET=

# Optional browser-visible WebSocket base URL, without /ws.
# The default uses ws://localhost:${BACKEND_PORT}. Changing it requires a rebuild.
# NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Browser calling: [] falls back to Google STUN. Add TURN for restrictive networks.
# See turn/README.md; rebuild the frontend after changing this build setting.
NEXT_PUBLIC_RTC_ICE_SERVERS=[]
